{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": ["node"],
    "composite": true
  },
  "include": [
    "vite.config.ts",
    "src/**/tests/**/*.ts",
    "src/market-game/domain.ts",
    "src/market-game/content.ts",
    "src/market-game/markets.ts",
    "src/market-game/equipment.ts",
    "src/market-game/contracts.ts",
    "src/market-game/storage.ts"
  ]
}
